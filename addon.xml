<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The lyrics extension point comes first deliberately: an addon's LibPath is
     taken from its first <extension>, and that is what RunScript resolves when
     a skin's lyrics button fires. -->
<addon id="script.kofin.lyrics" name="Kofin Lyrics" version="0.1.0" provider-name="kontell">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.lyrics" library="default.py"/>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/script.kofin.lyrics</source>
    <summary lang="en_GB">Song lyrics from your Jellyfin server</summary>
    <description lang="en_GB">Shows the lyrics stored on your Jellyfin server as a song plays, in time with the music where the server has timings. Lyrics are supplied by the Kofin addon, so nothing here needs a second login. Skins that draw lyrics themselves are used in preference to this addon's own window.</description>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
