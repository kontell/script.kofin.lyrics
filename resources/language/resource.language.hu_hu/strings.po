msgctxt "Addon Summary"
msgid "Song lyrics from your Jellyfin server"
msgstr "Dalszövegek a Jellyfin-kiszolgálójáról"

msgctxt "Addon Description"
msgid "Shows lyrics from a Jellyfin server, either in a window drawn by this add-on or handed to a skin."
msgstr "Dalszövegeket jelenít meg egy Jellyfin-kiszolgálóról, a kiegészítő saját ablakában vagy egy skinnek átadva."

msgctxt "#30001"
msgid "Show lyrics automatically"
msgstr "Dalszövegek automatikus megjelenítése"

msgctxt "#30002"
msgid "Show lyrics as each song starts, not only when the lyrics button is pressed. Some skins ignore this."
msgstr "Minden dal elején megjeleníti a dalszöveget, nem csak akkor, amikor megnyomja a dalszöveg gombját. Egyes skinek ezt figyelmen kívül hagyják."

msgctxt "#30003"
msgid "Show lyrics that have no timings"
msgstr "Szinkronizálatlan dalszövegek megjelenítése"

msgctxt "#30004"
msgid "Untimed lyrics stay still instead of following the song. Some skins ignore this."
msgstr "A szinkronizálatlan dalszövegek egy helyben maradnak, és nem követik a dalt. Egyes skinek ezt figyelmen kívül hagyják."

msgctxt "#30005"
msgid "Timing offset (seconds)"
msgstr "Időeltolás (másodperc)"

msgctxt "#30006"
msgid "Raise it if lines come too early, lower it if they come too late."
msgstr "Növelje, ha a sorok túl korán jönnek, és csökkentse, ha túl későn."

msgctxt "#30009"
msgid "Lyrics window height (pixels)"
msgstr "A dalszövegablak magassága (képpont)"

msgctxt "#30010"
msgid "From the top of the screen. 480 clears the now-playing info; 800 is full height."
msgstr "A képernyő tetejétől. A 480 szabadon hagyja a lejátszási információkat; a 800 a teljes magasság."

msgctxt "#30011"
msgid "No lyrics to show for this song"
msgstr "Nincs megjeleníthető dalszöveg ehhez a dalhoz"
