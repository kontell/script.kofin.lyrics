msgctxt "Addon Summary"
msgid "Song lyrics from your Jellyfin server"
msgstr "Texty piesní z vášho servera Jellyfin"

msgctxt "Addon Description"
msgid "Shows lyrics from a Jellyfin server, either in a window drawn by this add-on or handed to a skin."
msgstr "Zobrazuje texty piesní zo servera Jellyfin, buď v okne, ktoré vykresľuje tento doplnok, alebo ich odovzdá vzhľadu."

msgctxt "#30001"
msgid "Show lyrics automatically"
msgstr "Zobrazovať texty automaticky"

msgctxt "#30002"
msgid "Show lyrics as each song starts, not only when the lyrics button is pressed. Some skins ignore this."
msgstr "Zobrazí text na začiatku každej piesne, nielen po stlačení tlačidla textov. Niektoré vzhľady to ignorujú."

msgctxt "#30003"
msgid "Show lyrics that have no timings"
msgstr "Zobrazovať nesynchronizované texty"

msgctxt "#30004"
msgid "Untimed lyrics stay still instead of following the song. Some skins ignore this."
msgstr "Nesynchronizované texty stoja na mieste namiesto toho, aby sledovali pieseň. Niektoré vzhľady to ignorujú."

msgctxt "#30005"
msgid "Timing offset (seconds)"
msgstr "Časový posun (sekundy)"

msgctxt "#30006"
msgid "Raise it if lines come too early, lower it if they come too late."
msgstr "Zvýšte ho, ak riadky prichádzajú príliš skoro, a znížte, ak príliš neskoro."

msgctxt "#30009"
msgid "Lyrics window height (pixels)"
msgstr "Výška okna s textami (pixely)"

msgctxt "#30010"
msgid "From the top of the screen. 480 clears the now-playing info; 800 is full height."
msgstr "Od horného okraja obrazovky. 480 nezakrýva informácie o prehrávaní; 800 je plná výška."

msgctxt "#30011"
msgid "No lyrics to show for this song"
msgstr "Pre túto skladbu nie je žiadny text na zobrazenie"
