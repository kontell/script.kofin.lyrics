msgctxt "Addon Summary"
msgid "Song lyrics from your Jellyfin server"
msgstr "Kappaleiden sanoitukset Jellyfin-palvelimeltasi"

msgctxt "Addon Description"
msgid "Shows lyrics from a Jellyfin server, either in a window drawn by this add-on or handed to a skin."
msgstr "Näyttää sanoitukset Jellyfin-palvelimelta joko tämän lisäosan omassa ikkunassa tai ulkoasun piirtämänä."

msgctxt "#30001"
msgid "Show lyrics automatically"
msgstr "Näytä sanoitukset automaattisesti"

msgctxt "#30002"
msgid "Show lyrics as each song starts, not only when the lyrics button is pressed."
msgstr "Näytä sanoitukset jokaisen kappaleen alkaessa, ei vain sanoituspainiketta painettaessa."

msgctxt "#30003"
msgid "Show lyrics that have no timings"
msgstr "Näytä synkronoimattomat sanoitukset"

msgctxt "#30004"
msgid "Untimed lyrics stay still instead of following the song."
msgstr "Synkronoimattomat sanoitukset pysyvät paikallaan eivätkä seuraa kappaletta."

msgctxt "#30005"
msgid "Timing offset (seconds)"
msgstr "Ajoituksen siirtymä (sekuntia)"

msgctxt "#30006"
msgid "Raise it if lines come too early, lower it if they come too late."
msgstr "Kasvata arvoa, jos rivit tulevat liian aikaisin, ja pienennä sitä, jos ne tulevat liian myöhään."

msgctxt "#30009"
msgid "Lyrics window height (pixels)"
msgstr "Sanoitusikkunan korkeus (pikseliä)"

msgctxt "#30010"
msgid "From the top of the screen. 480 clears the now-playing info; 800 is full height."
msgstr "Näytön yläreunasta. 480 jättää toistotiedot näkyviin; 800 on koko korkeus."
