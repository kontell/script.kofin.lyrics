msgctxt "Addon Summary"
msgid "Song lyrics from your Jellyfin server"
msgstr "Låttexter från din Jellyfin-server"

msgctxt "Addon Description"
msgid "Shows lyrics from a Jellyfin server, either in a window drawn by this add-on or handed to a skin."
msgstr "Visar låttexter från en Jellyfin-server, antingen i ett fönster som det här tillägget ritar eller överlämnade till en skin."

msgctxt "#30001"
msgid "Show lyrics automatically"
msgstr "Visa låttexter automatiskt"

msgctxt "#30002"
msgid "Show lyrics as each song starts, not only when the lyrics button is pressed."
msgstr "Visa låttexten när varje låt börjar, inte bara när du trycker på låttextknappen."

msgctxt "#30003"
msgid "Show lyrics that have no timings"
msgstr "Visa osynkroniserade låttexter"

msgctxt "#30004"
msgid "Untimed lyrics stay still instead of following the song."
msgstr "Osynkroniserade låttexter står still i stället för att följa låten."

msgctxt "#30005"
msgid "Timing offset (seconds)"
msgstr "Tidsförskjutning (sekunder)"

msgctxt "#30006"
msgid "Raise it if lines come too early, lower it if they come too late."
msgstr "Höj den om raderna kommer för tidigt och sänk den om de kommer för sent."

msgctxt "#30009"
msgid "Lyrics window height (pixels)"
msgstr "Höjd på låttextfönstret (pixlar)"

msgctxt "#30010"
msgid "From the top of the screen. 480 clears the now-playing info; 800 is full height."
msgstr "Från skärmens överkant. 480 lämnar uppspelningsinformationen fri; 800 är full höjd."
