<?xml version="1.0" encoding="UTF-8"?>
<!-- This addon's own lyrics window. Stock textures only: the skin may not have
     any to lend. A plain list, so a song starts at the top. The geometry here
     is the largest the panel gets; window.py sizes it. -->
<window>
	<controls>
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="300"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="300"/>
			</animation>
			<right>40</right>
			<width>1240</width>
			<top>100</top>
			<height>800</height>
			<control type="image" id="101">
				<left>0</left>
				<top>0</top>
				<width>1240</width>
				<height>800</height>
				<texture colordiffuse="CC000000">white.png</texture>
				<aspectratio>stretch</aspectratio>
			</control>
			<control type="label" id="102">
				<left>20</left>
				<top>10</top>
				<width>1200</width>
				<height>44</height>
				<font>font13</font>
				<textcolor>FF00A4DC</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<!-- Artist and title often run wider than the lyrics. -->
				<scroll>true</scroll>
				<label>$INFO[MusicPlayer.Artist] - $INFO[MusicPlayer.Title]</label>
			</control>
			<control type="list" id="100">
				<left>20</left>
				<top>60</top>
				<width>1200</width>
				<height>720</height>
				<scrolltime tween="sine" easing="out">350</scrolltime>
				<onup>100</onup>
				<ondown>100</ondown>
				<onleft>100</onleft>
				<onright>100</onright>
				<itemlayout height="60" width="1200">
					<control type="label">
						<width>1200</width>
						<height>60</height>
						<font>font13</font>
						<textcolor>B3FFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout height="60" width="1200">
					<control type="label">
						<width>1200</width>
						<height>60</height>
						<font>font14</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>
		</control>
		<!-- Rulers for LyricsWindow.refit: auto width sizes each to the measure
		     property's text, hidden or not; see MEASURE_ID_FIRST. font14 is the
		     focused row's font, the widest a line renders. -->
		<control type="label" id="3901"><left>0</left><top>0</top><width>auto</width><height>60</height><font>font14</font><visible>false</visible><label>$INFO[Window(Home).Property(kofin.lyric.measure)]</label></control>
