<?xml version="1.0" encoding="UTF-8"?>
<!-- This addon's own lyrics window, used on skins that do not draw lyrics
     themselves. Centred and self-contained: stock textures only, since a skin
     that knows nothing about us cannot be relied on for art.

     A plain list, not a fixedlist. A fixedlist pins the sung line to one row
     from the very first line, so a track opens with the words mid-panel and
     blank space above them. A plain list lets the cursor walk down from the
     top, and the presenter scrolls it once the line reaches the middle -- see
     Presenter._position_list.

     Shown only over the visualisation window, which is the one place where
     taking input costs nothing -- an addon window becomes the active window,
     so anywhere else it would swallow navigation.

     It is also the only place lyrics can be scrolled by hand. Kodi's keymap
     binds the arrow keys in the visualisation window to StepBack/SkipNext, so
     a list a skin draws there never sees them however it is focused; a window
     of our own gets ordinary navigation. Hence a skin's passive overlay hands
     over to this on demand. Geometry matches contuary's overlay so that reads
     as the same panel waking up. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<controls>
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="300"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="300"/>
			</animation>
			<right>40</right>
			<width>640</width>
			<top>100</top>
			<height>800</height>
			<control type="image" id="101">
				<left>0</left>
				<top>0</top>
				<width>640</width>
				<height>800</height>
				<texture colordiffuse="CC000000">white.png</texture>
				<aspectratio>stretch</aspectratio>
			</control>
			<control type="label" id="102">
				<left>20</left>
				<top>10</top>
				<width>600</width>
				<height>44</height>
				<font>font13</font>
				<textcolor>FF00A4DC</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<!-- Scrolls rather than truncating: the panel is sized to the
				     lyrics, and an artist and title together are routinely
				     longer than any line of the song. -->
				<scroll>true</scroll>
				<label>$INFO[MusicPlayer.Artist] - $INFO[MusicPlayer.Title]</label>
			</control>
			<control type="list" id="100">
				<left>20</left>
				<top>60</top>
				<width>600</width>
				<height>720</height>
				<scrolltime tween="sine" easing="out">350</scrolltime>
				<onup>100</onup>
				<ondown>100</ondown>
				<onleft>100</onleft>
				<onright>100</onright>
				<itemlayout height="60" width="600">
					<control type="label">
						<width>600</width>
						<height>60</height>
						<font>font13</font>
						<textcolor>B3FFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout height="60" width="600">
					<control type="label">
						<width>600</width>
						<height>60</height>
						<font>font14</font>
						<textcolor>FFFFFFFF</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
